---
import Layout from '../layouts/Layout.astro';
import LanguageArt from '../components/LanguageArt.astro';
import CampusHero from '../components/CampusHero.astro';
import Arrow from '../components/Arrow.astro';
import HomeSections from '../components/HomeSections.astro';
import LatestNews from '../components/LatestNews.astro';
import { site, news } from '../data/lab';
import { placeholders } from '../data/ui';
import { path } from '../lib/utils';
const latest = [...news].sort((a,b) => b.date.localeCompare(a.date)).slice(0, 3);
const hasCampus = site.branding.enabled && Boolean(site.branding.heroImage);
---
<Layout>
  <section class:list={['hero', 'hero-immersive', { 'has-campus-background': hasCampus }]}>
    {hasCampus && <CampusHero />}
    <div class="container hero-inner">
    <div class="hero-copy">
      <h1>{(site.heroTitle || placeholders.heroTitle).split('\n').map((line, index) => <span class:list={{ 'hero-last-line': index > 0 }}>{line}</span>)}</h1>
      <p class="hero-description">{site.introduction || placeholders.introduction}</p>
      <div class="hero-actions"><a class="button button-primary" href={path('research')}>Explore research <Arrow /></a><a class="text-link" href={path('people')}>Meet the people <span aria-hidden="true">↗</span></a></div>
    </div>
    {!hasCampus && <LanguageArt />}
    </div>
  </section>

  <LatestNews items={latest} />

  <HomeSections />
</Layout>
