---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import EmptyState from '../components/EmptyState.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications } from '../data/lab';
import { placeholders } from '../data/ui';
const years = [...new Set(publications.map(p => p.year))].sort((a,b) => b-a);
---
<Layout title="Publications"><PageIntro english="PUBLICATION ARCHIVE" title="Publications" description="Academic publications and research outputs, organised by year, with links to papers, code, projects and citations." /><section class="container page-content">
  {publications.length ? <><form class="publication-filters" role="search" hidden><div class="filter-search"><label for="publication-search">Search publications</label><input id="publication-search" type="search" placeholder="Search titles, authors or venues…" autocomplete="off" /></div><div><label for="publication-year">Publication year</label><select id="publication-year"><option value="all">All years</option>{years.map(year => <option value={String(year)}>{year}</option>)}</select></div></form><p class="filter-result" role="status" aria-live="polite" hidden></p><div class="publication-groups">{years.map(year => <section class="publication-year-group" data-year-group><h2 class="year-heading">{year}<span>{publications.filter(p => p.year === year).length} {publications.filter(p => p.year === year).length === 1 ? 'publication' : 'publications'}</span></h2>{publications.filter(p => p.year === year).map(publication => <PublicationItem publication={publication} />)}</section>)}</div><p class="filter-no-results" hidden>No matching publications. Try another keyword or year.</p></> : <EmptyState title={placeholders.publications} description="Publications will be listed by year. Search and year filters will be available once entries are added." kind="paper" />}
</section></Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('.publication-filters');
  const search = document.querySelector<HTMLInputElement>('#publication-search');
  const year = document.querySelector<HTMLSelectElement>('#publication-year');
  const result = document.querySelector<HTMLElement>('.filter-result');
  if (form && search && year && result) {
    form.hidden = false; result.hidden = false;
    form.addEventListener('submit', event => event.preventDefault());
    const filter = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-publication]').forEach(item => {
        const match = (year.value === 'all' || item.dataset.year === year.value) && (item.dataset.search || '').includes(query);
        item.hidden = !match; if (match) count++;
      });
      document.querySelectorAll<HTMLElement>('[data-year-group]').forEach(group => { group.hidden = !group.querySelector('[data-publication]:not([hidden])'); });
      result.textContent = `${count} publication${count === 1 ? '' : 's'}`;
      const empty = document.querySelector<HTMLElement>('.filter-no-results');
      if (empty) empty.hidden = count > 0;
    };
    search.addEventListener('input', filter); year.addEventListener('change', filter); filter();
  }
</script>
