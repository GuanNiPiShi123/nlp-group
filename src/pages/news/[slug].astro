---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { news, type NewsItem } from '../../data/lab';
import { path, displayDate, safeLink } from '../../lib/utils';
export const getStaticPaths = (() => news.map(item => ({ params: { slug: item.slug }, props: { item } }))) satisfies GetStaticPaths;
interface Props { item: NewsItem }
const { item } = Astro.props;
---
<Layout title={item.title} description={item.summary}><article class="container news-detail"><a class="text-link" href={path('news')}>← All news</a><div class="eyebrow">NEWS & UPDATES <time datetime={item.date}>{displayDate(item.date)}</time></div><h1>{item.title}</h1>{item.summary && <p class="news-summary">{item.summary}</p>}<div class="prose">{item.content?.split(/\n\s*\n/).map(paragraph => <p>{paragraph}</p>)}</div>{safeLink(item.url) && <a class="text-link" href={safeLink(item.url)}>Read the original ↗</a>}</article></Layout>
