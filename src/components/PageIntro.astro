---
interface Props { english: string; title: string; description: string }
const { english, title, description } = Astro.props;
---
<section class="page-intro container">
  <div class="eyebrow">{english}</div>
  <div class="page-intro-grid"><h1>{title}<span class="title-period">.</span></h1><p>{description}</p></div>
</section>
